{
  "version": "1.0",
  "source": "RBI Master Directions on Payment Aggregators, September 2025",
  "checks": [
    {
      "id": "RBI-001",
      "category": "Policy Disclosure",
      "name": "Refund / Cancellation Policy",
      "severity": "critical",
      "description": "Merchants must display a clear refund and cancellation policy accessible from the website.",
      "detection_strategy": "page_search",
      "search": {
        "url_patterns": [
          "/refund",
          "/return",
          "/cancellation",
          "/refund-policy",
          "/return-policy",
          "/cancel",
          "/money-back"
        ],
        "link_text_patterns": [
          "refund",
          "return",
          "cancellation",
          "money back",
          "cancel policy"
        ],
        "footer_patterns": [
          "refund policy",
          "return policy",
          "cancellation policy"
        ],
        "body_keywords": [
          "refund",
          "cancellation",
          "return policy",
          "money back guarantee"
        ]
      },
      "quality_criteria": {
        "min_word_count": 150,
        "must_contain_topics": [
          "timeline",
          "eligibility",
          "process",
          "contact"
        ],
        "red_flags": [
          "lorem ipsum",
          "coming soon",
          "under construction",
          "tbd"
        ]
      },
      "business_type_variations": {
        "ecommerce": {
          "extra_topics": [
            "shipping",
            "damaged goods",
            "original condition"
          ]
        },
        "saas": {
          "extra_topics": [
            "subscription",
            "pro-rata",
            "trial period"
          ]
        },
        "services": {
          "extra_topics": [
            "service delivery",
            "work completed"
          ]
        },
        "food_delivery": {
          "extra_topics": [
            "order cancellation window",
            "undelivered order",
            "incorrect or spoiled items"
          ]
        }
      }
    },
    {
      "id": "RBI-002",
      "category": "Privacy",
      "name": "Privacy Policy",
      "severity": "critical",
      "description": "Merchants must publish a privacy policy covering data collection, usage, and sharing under Indian law (IT Act 2000, DPDP Act 2023).",
      "detection_strategy": "page_search",
      "search": {
        "url_patterns": [
          "/privacy",
          "/privacy-policy",
          "/data-policy",
          "/data-protection"
        ],
        "link_text_patterns": [
          "privacy",
          "data policy",
          "privacy policy"
        ],
        "footer_patterns": [
          "privacy policy",
          "privacy notice"
        ],
        "body_keywords": [
          "personal data",
          "data collection",
          "information we collect",
          "your privacy",
          "cookies"
        ]
      },
      "quality_criteria": {
        "min_word_count": 300,
        "must_contain_topics": [
          "data collection",
          "purpose",
          "storage",
          "sharing",
          "user rights",
          "contact"
        ],
        "red_flags": [
          "lorem ipsum",
          "sample privacy policy",
          "template",
          "another company"
        ]
      },
      "business_type_variations": {
        "ecommerce": {
          "extra_topics": [
            "payment data",
            "shipping address",
            "order history"
          ]
        },
        "saas": {
          "extra_topics": [
            "account data",
            "usage analytics",
            "third-party integrations"
          ]
        },
        "services": {
          "extra_topics": [
            "client data",
            "project files"
          ]
        },
        "food_delivery": {
          "extra_topics": [
            "delivery partner data sharing",
            "live location tracking"
          ]
        }
      }
    },
    {
      "id": "RBI-003",
      "category": "Legal",
      "name": "Terms and Conditions",
      "severity": "critical",
      "description": "Merchants must publish comprehensive terms of service with Indian governing law.",
      "detection_strategy": "page_search",
      "search": {
        "url_patterns": [
          "/terms",
          "/tos",
          "/terms-and-conditions",
          "/terms-of-service",
          "/terms-of-use",
          "/legal"
        ],
        "link_text_patterns": [
          "terms",
          "conditions",
          "terms of service",
          "tos",
          "terms of use"
        ],
        "footer_patterns": [
          "terms and conditions",
          "terms of service",
          "terms of use"
        ],
        "body_keywords": [
          "terms of service",
          "terms and conditions",
          "user agreement",
          "governing law",
          "dispute resolution"
        ]
      },
      "quality_criteria": {
        "min_word_count": 300,
        "must_contain_topics": [
          "user obligations",
          "service description",
          "payment terms",
          "liability",
          "governing law"
        ],
        "red_flags": [
