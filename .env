# LLM — Bedrock mantle (default path)
OPENAI_API_KEY=your-bearer-token-here
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
LLM_MODEL=qwen.qwen3-32b

# Or Anthropic direct — leave the OPENAI_* vars empty to use this
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Razorpay test mode (optional)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

DATABASE_URL=sqlite+aiosqlite:///./mcie.db
LOG_LEVEL=INFO
CRAWLER_TIMEOUT=30
CRAWLER_MAX_PAGES=20

